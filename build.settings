--
-- For more information on build.settings, see the Project Build Settings guide at:
-- https://docs.coronalabs.com/guide/distribution/buildSettings
--

settings =
{
	orientation =
	{
		-- Supported values for orientation:
		-- portrait, portraitUpsideDown, landscapeLeft, landscapeRight
		default = "portrait",
		supported = { 'portrait'},
	},

	--
	-- Android section
	--
	android =
	{
		usesPermissions = {
			"android.permission.INTERNET",
			"android.permission.ACCESS_NETWORK_STATE",
			"android.premission.CALL_PHONE",
			"android.permission.VIBRATE",
			"android.permission.WRITE_EXTERNAL_STORAGE",
        },
	},

	--
	-- iOS section
	--
	iphone =
	{
		xcassets = "Images.xcassets",
		plist =
		{
			UIStatusBarHidden = false,
			UILaunchStoryboardName = "LaunchScreen",
		},
	},
	
	window = {
		defaultViewWidth = 2100,
		defaultViewHeight = 1980,
		resizable=true,
	},

	--
	-- Plugins section
	--
	plugins =
	{
        ["plugin.androidFilePicker"] = {publisherId="tech.scotth",marketplaceId = "zag4fj"},
		['plugin.pasteboard'] = {publisherId = 'com.coronalabs'},
		['plugin.exportFile'] = {publisherId = 'com.solar2d'},
		['plugin.zip'] = {publisherId = 'com.coronalabs' ,supportedPlatforms = { android = false }},
		['plugin.orientation'] = {publisherId = "tech.scotth", marketplaceId="zag4fj",},
		["plugin.tinyfiledialogs"] = {publisherId = "com.coronalabs",supportedPlatforms = { android = false, win32=true }},
	},

	--
	-- Project section
	--
	excludeFiles =
	{
		all = { "Icon.png", "Icon-*dpi.png", "Images.xcassets", },
		android = { "LaunchScreen.storyboardc", },
	},
}